{
  "expo": {
    "name": "media-on",
    "slug": "media-on",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/media-on-app-icon.png",
    "scheme": "mediaon",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1A1C29",
    "primaryColor": "#182366",
    "ios": {
      "icon": "./assets/images/media-on-app-icon.png",
      "bundleIdentifier": "com.leeinjun.mediaon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/media-on-app-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#182366",
        "foregroundImage": "./assets/images/media-on-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.leeinjun.mediaon",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/media-on-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#182366",
          "image": "./assets/images/media-on-app-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 변경하기 위해 사진 보관함에 접근합니다.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#182366",
          "defaultChannel": "media-on"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d2828b7-d6d9-47fa-9d31-f9d683a5e19e"
      }
    },
    "owner": "leeinjun"
  }
}
